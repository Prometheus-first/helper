{
  "backend": "native_text",
  "chat_allowlist": [],
  "image_directory": ".runtime/images",
  "file_directory": ".runtime/files",
  "emoticon_directory": ".runtime/emoticons",
  "wechat_data_directory": null,
  "wechat_pid": null,
  "wechat_account": null,
  "reconnect_seconds": 5,
  "plugin_queue_size": 128,
  "console": true,
  "log_level": "INFO",
  "llm_config_file": "llm_config.json",
  "members_config_file": "members_config.json",
  "text_send_delay": {
    "enabled": true,
    "characters_per_group": 10,
    "min_seconds": 0.1,
    "max_seconds": 0.3
  },
  "plugins": {
    "group_notice": {
      "enabled": false,
      "welcome": true,
      "leave_notice": true,
      "welcome_template": "欢迎 {nickname} 加入群聊！",
      "leave_template": "{nickname} 离开了群聊。"
    },
    "friend_auto_accept": {
      "enabled": false,
      "verification_keywords": []
    },
    "personality": {
      "enabled": true
    },
    "mention_chat": {
      "enabled": false
    },
    "chat_summary": {
      "enabled": false
    },
    "chat_records": {
      "enabled": true
    },
    "member_identity": {
      "enabled": true
    },
    "idiom_chain": {
      "enabled": false,
      "member_names": {}
    },
    "id_responder": {
      "enabled": true
    },
    "echo": {
      "enabled": true,
      "prefix": "echo "
    }
  }
}
